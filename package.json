{
  "name": "chess-analyzer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy-engine": "node scripts/copy-stockfish.mjs",
    "predev": "npm run copy-engine",
    "prebuild": "npm run copy-engine",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "calibrate": "rolldown scripts/calibrate/calibrate.ts --platform node --format esm --dir node_modules/.cache/calibrate && node node_modules/.cache/calibrate/calibrate.js"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
